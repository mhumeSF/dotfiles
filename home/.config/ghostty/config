term = xterm-256color

confirm-close-surface = false
# font-family = "Iosevka Term Extended"
font-family = "BerkeleyMono Nerd Font Mono"
font-size = 16
mouse-hide-while-typing = true
window-decoration = true
macos-titlebar-style = hidden

# theme = "Material Design Colors"
theme = "Popping And Locking"

# Cursor shaders, one at a time (both repos pinned via home-manager):
#  shaders/            sahaj-b/ghostty-cursor-shaders: cursor_warp, cursor_sweep,
#                      cursor_tail, sonic_boom_cursor, ripple_cursor,
#                      rectangle_boom_cursor, ripple_rectangle_cursor
#  shaders-playground/ KroneCorylus/ghostty-shader-playground: cursor_blaze,
#                      cursor_blaze_no_trail, cursor_blaze_tapered, cursor_smear,
#                      cursor_smear_fade, cursor_smear_rainbow, manga_slash, ...
# custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders-playground/cursor_blaze.glsl
